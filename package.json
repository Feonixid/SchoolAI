{
  "name": "EduAI",
  "version": "2.0.0",
  "description": "EduAI — Educational AI Platform. Powered by Gemma 4, runs fully offline via Ollama. Multi-language, hardware-adaptive.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build": "electron-builder --win --publish never",
    "check": "node -c server.js && jest",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "monaco-editor": "^0.55.1",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.EduAI.app",
    "productName": "EduAI",
    "copyright": "Copyright 2026 EduAI",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "electron/**/*",
      "css/**/*",
      "js/**/*",
      "prompts/**/*",
      "docs/**/*",
      "icons/**/*",
      "*.html",
      "*.jpg",
      "*.png",
      "manifest.json",
      "sw.js",
      "server.js",
      "package.json",
      "!accounts-data.json",
      "!.env",
      "!tests/**/*"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/voice.js"
    ],
    "moduleDirectories": [
      "node_modules",
      "js"
    ]
  }
}
