        {
          "title": "Solving multi-step equations",
          "concepts": [
            "distributive property",
            "combining like terms",
            "variables on both sides"
          ],
          "keyFormulas": [
            "ax + b = c → x = (c-b)/a"
          ],
          "keyFacts": [
            "Always check solution by substituting back",
            "No solution when you get a contradiction like 5 = 3",
            "Infinite solutions when you get an identity like 0 = 0"
          ]
        },
