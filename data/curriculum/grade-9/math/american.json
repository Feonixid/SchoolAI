          "title": "Systems of Linear Equations",
          "concepts": [
            "substitution",
            "elimination",
            "graphing method"
          ],
          "keyFormulas": [
            "y = mx + b",
            "Ax + By = C (standard form)"
          ],
          "keyFacts": [
            "Parallel lines: no solution",
            "Same line: infinite solutions",
            "Intersecting: exactly one solution"
          ]
        },
        {
          "title": "Linear Inequalities",
          "concepts": [
            "inequality symbols",
            "graphing on number line",
            "compound inequalities"
          ],
          "keyFacts": [
            "Flip the inequality sign when multiplying or dividing by a negative",
            "AND inequalities: intersection",
            "OR inequalities: union"
          ]
        }
      ],
      "commonMisconceptions": [
        "Forgetting to flip inequality when dividing by negative",
        "Distributing without changing all signs"
      ]
