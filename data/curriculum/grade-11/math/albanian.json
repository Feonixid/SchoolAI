          "concepts": [
            "limit",
            "limiti i funksionit",
            "limiti i pafund"
          ],
          "keyFormulas": [
            "lim(x→a) f(x) = L",
            "lim(x→∞) 1/x = 0",
            "lim(x→0) sinx/x = 1"
