# EduAI - Production Environment Configuration Template
# Copy this file to .env and customize values for your deployment.

# Server Port & Networking
PORT=3001
HOST=0.0.0.0

# Administrative Credentials (Set upon first installation)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password
ADMIN_API_KEY=csk_eduai_production_key_change_me

# JWT Authentication Secret
JWT_SECRET=eduai_jwt_secret_key_production_change_me

# Ollama LLM Inference Configuration (Local Offline)
OLLAMA_HOST=http://127.0.0.1:11434
# Memory Savings: f16 (100% quality), q8_0 (50% memory savings, recommended), q4_0 (75% memory savings)
OLLAMA_KV_CACHE_TYPE=q8_0
# Set to 1 if your GPU/CPU supports Flash Attention
OLLAMA_FLASH_ATTENTION=0
# Context length in tokens (4096 default, 8192 for high-end)
OLLAMA_CONTEXT_LENGTH=4096

# PeerJS LAN Mesh Configuration (Optional custom signaling)
PEERJS_PORT=9000
